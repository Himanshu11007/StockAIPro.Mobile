<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.

         aps-environment: Push Notifications capability (APNs). "development"
         for debug/TestFlight-sandbox builds; Apple's signing replaces it with
         "production" for App Store distribution profiles. The App ID must
         have Push Notifications enabled (docs/NOTIFICATIONS.md).

         Sign in with Apple is not offered by the app, so the
         com.apple.developer.applesignin entitlement is intentionally absent. -->
    <dict>
        <key>aps-environment</key>
        <string>development</string>
    </dict>
</plist>
