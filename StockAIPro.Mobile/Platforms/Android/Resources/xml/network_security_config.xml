<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (HTTP, not HTTPS) traffic ONLY to the local-development
  backend addresses: 10.0.2.2 (Android emulator's alias for the host
  machine's loopback - see Services/Configuration/ApiConfiguration.cs) and
  127.0.0.1/localhost (physical device over adb reverse, or other local
  targets). No other domain is covered, so this does not weaken security
  for any real (production) API domain, which will be HTTPS and is
  unaffected by this file - Android's default (cleartext traffic blocked)
  applies to everything else.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
