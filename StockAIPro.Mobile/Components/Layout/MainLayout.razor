@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject IPinService PinService
@inject NavigationManager Navigation
@implements IDisposable

<div class="app-shell">
    <header class="app-topbar">
        <span class="app-topbar-brand">StockAI Pro</span>
        <span class="app-topbar-subtitle">AI-Powered Stock Intelligence</span>
    </header>

    <main class="app-content">
        @Body
    </main>

    @if (AuthService.IsAuthenticated)
    {
        <NavMenu />
    }
</div>

@code {
    // Runs once when the app's single long-lived Blazor Hybrid session
    // starts (this layout is not recreated on client-side navigation) -
    // the "on application startup" hook: try to restore a session from
    // secure storage without blocking the UI if the backend is unreachable.
    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;

        if (await PinService.IsPinSetAsync())
        {
            // A PIN gate exists for this device - require it before
            // touching the stored session at all. PinUnlock.razor itself
            // calls TryRestoreSessionAsync() after a correct PIN (the exact
            // same call this branch would otherwise make directly), so the
            // existing refresh/session-restore pipeline is never bypassed,
            // only deferred behind the PIN check.
            Navigation.NavigateTo("/pin-unlock");
            return;
        }

        await AuthService.TryRestoreSessionAsync();
    }

    // The bottom nav's visibility depends on IsAuthenticated, which can
    // flip asynchronously after this component's first render (session
    // restore above, or a login/logout elsewhere) - without this
    // subscription the nav would not appear/disappear until some unrelated
    // re-render happened. See NavMenu/Home/Login/Register/Account for the
    // same pattern; every component that reads AuthService state needs it.
    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthService.AuthStateChanged -= OnAuthStateChanged;
}
