@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject IPinService PinService
@inject AppConfigService AppConfig
@inject NavigationManager Navigation
@inject PendingNavigationService PendingNavigation
@inject SignInFlow SignInFlow
@inject NotificationStateService NotificationState
@inject PushRegistrationService PushRegistration
@implements IDisposable

<div class="app-shell">
    <header class="app-topbar">
        <div>
            <span class="app-topbar-brand">StockLens</span>
            <span class="app-topbar-subtitle">Transparent stock analysis</span>
        </div>
        @if (AuthService.IsAuthenticated && AppConfig.IsEnabled("notifications"))
        {
            <a class="sai-bell" href="notifications" aria-label="@($"Notifications, {NotificationState.UnreadCount} unread")">
                <span aria-hidden="true">&#128276;</span>
                @if (NotificationState.UnreadCount > 0)
                {
                    <span class="sai-bell-badge">@(NotificationState.UnreadCount > 99 ? "99+" : NotificationState.UnreadCount.ToString())</span>
                }
            </a>
        }
    </header>

    <main class="app-content">
        @Body
    </main>

    @if (AuthService.IsAuthenticated)
    {
        <NavMenu />
    }
</div>

@code {
    // Runs once when the app's single long-lived Blazor Hybrid session
    // starts (this layout is not recreated on client-side navigation).
    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
        NotificationState.Changed += OnBadgeChanged;
        PendingNavigation.DestinationRequested += OnDestinationRequested;

        // Backend-controlled feature flags/disclaimer/onboarding (public endpoint).
        _ = AppConfig.LoadAsync();

        if (!OnboardingState.Completed)
        {
            Navigation.NavigateTo("/welcome");
            return;
        }

        if (await PinService.IsPinSetAsync())
        {
            // A PIN gate exists for this device - require it before touching
            // the stored session. PinUnlock restores the session itself.
            Navigation.NavigateTo("/pin-unlock");
            return;
        }

        if (await AuthService.TryRestoreSessionAsync())
            OpenPendingDestination();
    }

    /// <summary>A notification tap or stockaipro:// link while the app runs.</summary>
    private void OnDestinationRequested() => InvokeAsync(() =>
    {
        if (AuthService.IsAuthenticated)
        {
            OpenPendingDestination();
        }
        else if (OnboardingState.Completed && !Navigation.Uri.Contains("/login") && !Navigation.Uri.Contains("/pin-unlock"))
        {
            // Kept by PendingNavigationService and opened after sign-in.
            Navigation.NavigateTo("/login");
        }
    });

    private void OpenPendingDestination()
    {
        if (SignInFlow.TakePending(AuthService.IsAuthenticated) is { } route)
            Navigation.NavigateTo(route);
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
        NotificationState.Changed -= OnBadgeChanged;
        PendingNavigation.DestinationRequested -= OnDestinationRequested;
    }
}
