@page "/top-picks"
@* Top Investment Candidates: the backend's ranked list (FQVF + StockAI
   Score) from its latest completed engine run. This page only displays
   what the backend returns - no ranking or filtering happens here. *@
@inject IProductApiClient ProductApi
@inject AppConfigService AppConfig
@inject NavigationManager Navigation
@implements IDisposable

<div class="sai-card">
    <div class="sai-card-title">Top Investment Candidates</div>
    <div class="sai-action-desc">Highest-ranked stocks by StockAI Score from the latest analysis run.</div>
</div>

@if (_loading)
{
    <LoadingState Message="Loading candidates..." />
}
else if (_error is not null)
{
    @if (_errorKind == ApiErrorKind.Unauthorized)
    {
        <ErrorState Title="Session expired" Message="@_error" RetryLabel="Sign in again" OnRetry="@(() => Navigation.NavigateTo("/login"))" />
    }
    else
    {
        <ErrorState Title="Could not load candidates" Message="@_error" OnRetry="LoadAsync" />
    }
}
else if (_data is { } data)
{
    @if (data.MarketRegime is { } regime)
    {
        <div class="sai-card">
            <div class="sai-section-title">Market regime (@(regime.Index ?? "index"))</div>
            <div><strong>@(regime.Regime ?? ProductFormat.Missing)</strong> <span class="text-muted">as of @ProductFormat.Date(regime.AsOfDate)</span></div>
            @if (!string.IsNullOrEmpty(regime.Reason))
            {
                <div class="sai-action-desc">@regime.Reason</div>
            }
        </div>
    }

    @if (data.Items.Count == 0)
    {
        <EmptyState Title="No candidates yet"
                    Message="@(data.Run is null ? "The analysis engine has not completed a run yet." : "No stock met the data-quality and liquidity rules in the latest run.")"
                    ActionLabel="Refresh" OnAction="LoadAsync" />
    }
    else
    {
        <div class="sai-action-desc mb-2">
            Showing @data.Items.Count of @data.TotalEligible eligible stocks
            @if (data.Run is { } run)
            {
                <span> - run @ProductFormat.Date(run.FinishedAt), @run.StocksAnalysed analysed, engine @run.EngineVersion</span>
            }
        </div>

        @foreach (var item in data.Items)
        {
            <div class="sai-card sai-clickable" role="button" tabindex="0" @onclick="() => Open(item.Symbol)">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="sai-action-title">#@item.Rank @item.Name</div>
                        <div class="sai-action-desc">@item.Symbol @(item.Sector is null ? "" : $"- {item.Sector}")</div>
                    </div>
                    <div class="sai-score">
                        <div class="sai-score-value">@ProductFormat.Score(item.StockAiScore)</div>
                        <div class="sai-score-label">StockAI Score</div>
                    </div>
                </div>
                <div class="sai-metric-grid mt-2">
                    <MetricCard Label="FQVF score" Value="@ProductFormat.Score(item.FqvfScore)" />
                    <MetricCard Label="Data coverage" Value="@ProductFormat.Percent(item.ScoreCoverage, 0)" />
                </div>
                @if (!string.IsNullOrEmpty(item.FqvfSummary))
                {
                    <div class="sai-action-desc mt-1">FQVF: @item.FqvfSummary</div>
                }
                @if (item.Positives.Count > 0)
                {
                    <div class="sai-section-title mt-2">Positive factors</div>
                    <ul class="sai-list sai-list-positive">
                        @foreach (var p in item.Positives.Take(3)) { <li>@p</li> }
                    </ul>
                }
                @if (item.Risks.Count > 0)
                {
                    <div class="sai-section-title">Risks</div>
                    <ul class="sai-list sai-list-negative">
                        @foreach (var r in item.Risks.Take(3)) { <li>@r</li> }
                    </ul>
                }
                <div class="sai-action-desc">Market data as of @ProductFormat.Date(item.Freshness.GetValueOrDefault("market_data_as_of"))</div>
            </div>
        }
    }

    <Disclaimer Text="@(data.Disclaimer ?? AppConfig.Disclaimer)" />
}

@code {
    private TopCandidatesResponse? _data;
    private bool _loading = true;
    private string? _error;
    private ApiErrorKind? _errorKind;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _errorKind = null;
        StateHasChanged();
        try
        {
            _data = await ProductApi.GetTopCandidatesAsync(ct: _cts.Token);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _errorKind = ex.Kind;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            // Malformed response - never crash the page.
            _error = "The server returned data the app could not read.";
        }
        _loading = false;
        StateHasChanged();
    }

    private void Open(string symbol) => Navigation.NavigateTo($"/stock/{Uri.EscapeDataString(symbol)}");

    public void Dispose() => _cts.Cancel();
}
