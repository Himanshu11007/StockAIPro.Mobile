@page "/forgot-password"
@using StockAIPro.Mobile.Services.Api
@using StockAIPro.Mobile.Services.Authentication
@inject IAuthService AuthService

@* Asks the backend to email a reset link. The link opens the StockLens web
   app's /reset-password page; after choosing a new password there, the user
   signs in here with it. The backend answers identically whether or not the
   email has an account, so this page never says which it was. *@
<div class="sai-card">
    <div class="sai-card-title">Reset your password</div>

    @if (_confirmation is not null)
    {
        <p role="status">@_confirmation</p>
        <p>Open the link in that email (on this phone or any computer) to choose a new password,
           then sign in with it. The link expires soon and works once.</p>
        <p><a href="/login">Back to sign in</a></p>
    }
    else
    {
        <p>Enter your account's email address and we'll send you a link to choose a new password.</p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="email">Email</label>
                <InputText id="email" type="email" class="form-control" autocomplete="username" @bind-Value="_form.Email" />
                <ValidationMessage For="() => _form.Email" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="text-danger" role="alert">@_errorMessage</p>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                @(_isSubmitting ? "Sending..." : "Send reset link")
            </button>
        </EditForm>

        <p class="mt-3"><a href="/login">Back to sign in</a></p>
    }
</div>

@code {
    private readonly ForgotPasswordForm _form = new();
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _confirmation;

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            _confirmation = await AuthService.RequestPasswordResetAsync(_form.Email);
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.NetworkUnavailable)
        {
            _errorMessage = "Could not reach the StockLens server. Check your connection and try again.";
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.TooManyRequests)
        {
            _errorMessage = "Too many reset requests. Please wait a while and try again.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ForgotPasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
