@page "/login"
@using StockAIPro.Mobile.Services.Api
@using StockAIPro.Mobile.Services.Authentication
@inject IAuthService AuthService
@inject IPinService PinService
@inject IGoogleSignInService GoogleSignIn
@inject IAppleSignInService AppleSignIn
@inject NavigationManager Navigation
@inject SignInFlow SignInFlow
@implements IDisposable

<div class="sai-card">
    <div class="sai-card-title">Sign in</div>

    @if (AuthService.IsAuthenticated)
    {
        <p>You're already signed in as <strong>@(AuthService.CurrentUser?.Email ?? AuthService.CurrentUser?.Phone ?? "—")</strong>.</p>
        <p><a href="/account">Go to Account</a></p>
    }
    else
    {
        <button class="btn btn-outline-secondary w-100 mb-2" @onclick="SignInWithGoogleAsync" disabled="@_isSubmitting">
            Continue with Google
        </button>
        <button class="btn btn-outline-secondary w-100 mb-3" @onclick="SignInWithAppleAsync" disabled="@_isSubmitting">
            Continue with Apple
        </button>

        <p class="text-center mb-3">OR</p>

        <p class="mb-3"><a href="/login/otp">Login with OTP</a></p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="_form.Email" />
            </div>

            <div class="mb-3">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_form.Password" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="text-danger" role="alert">@_errorMessage</p>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                @(_isSubmitting ? "Signing in..." : "Login")
            </button>
        </EditForm>

        <p class="mt-3">
            Don't have an account? <a href="/register">Register</a>
        </p>
    }
</div>

@code {
    private readonly LoginForm _form = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthService.AuthStateChanged -= OnAuthStateChanged;

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            await AuthService.LoginAsync(_form.Email, _form.Password);
            await NavigateAfterLoginAsync();
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.NetworkUnavailable)
        {
            _errorMessage = "Could not reach the StockLens server. Check your connection and try again.";
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.Unauthorized)
        {
            _errorMessage = "Invalid email or password.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SignInWithGoogleAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var idToken = await GoogleSignIn.SignInAsync();
            if (idToken is null)
                { _errorMessage = "Sign-in was cancelled."; return; }

            await AuthService.LoginWithGoogleAsync(idToken);
            await NavigateAfterLoginAsync();
        }
        catch (GoogleSignInNotConfiguredException)
        {
            _errorMessage = "Google sign-in is not configured on this device.";
        }
        catch (GoogleSignInFailedException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.NetworkUnavailable)
        {
            _errorMessage = "Could not reach the StockLens server. Check your connection and try again.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SignInWithAppleAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var identityToken = await AppleSignIn.SignInAsync();
            if (identityToken is null)
                { _errorMessage = "Sign-in was cancelled."; return; }

            await AuthService.LoginWithAppleAsync(identityToken);
            await NavigateAfterLoginAsync();
        }
        catch (AppleSignInNotConfiguredException)
        {
            _errorMessage = "Apple sign-in is currently unavailable.";
        }
        catch (AppleSignInFailedException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.NetworkUnavailable)
        {
            _errorMessage = "Could not reach the StockLens server. Check your connection and try again.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task NavigateAfterLoginAsync()
    {
        // First successful authentication on this device with no PIN set
        // yet -> offer to set one up (Task 13's "Create your PIN" screen).
        // Already has one -> nothing to do here, PinUnlock.razor is only
        // shown on a later cold start, not immediately after a fresh login.
        // A notification the user tapped while signed out opens first;
        // otherwise Home, or the optional PIN set-up on a first sign-in here.
        Navigation.NavigateTo(SignInFlow.NextRoute(offerPinSetup: !await PinService.IsPinSetAsync()));
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
