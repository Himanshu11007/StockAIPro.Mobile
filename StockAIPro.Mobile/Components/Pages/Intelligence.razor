@page "/intelligence"
@* AI Intelligence: what each kind of signal is and how much weight it
   carries (GET /intelligence/overview). The ML signal is informational
   only; news is not point-in-time and not scored; legacy analytics belong to
   a retired engine and are shown collapsed, for transparency. *@
@inject IProductApiClient ProductApi
@inject IIntelligenceApiClient IntelligenceApiClient
@inject AppConfigService AppConfig
@inject NavigationManager Navigation

<div class="sai-card">
    <div class="sai-card-title">AI Intelligence</div>
    <div class="sai-action-desc">The signals behind the analysis, and exactly how each one is used.</div>
</div>

@if (_loading)
{
    <LoadingState Message="Loading..." />
}
else if (_error is not null)
{
    @if (_errorKind == ApiErrorKind.Unauthorized)
    {
        <ErrorState Title="Session expired" Message="@_error" RetryLabel="Sign in again" OnRetry="@(() => Navigation.NavigateTo("/login"))" />
    }
    else
    {
        <ErrorState Title="Couldn't load this page" Message="@_error" OnRetry="LoadAsync" />
    }
}
else if (_overview is { } o)
{
    @foreach (var section in o.Sections.Where(x => x.Key != "legacy"))
    {
        <div class="sai-card">
            <div class="d-flex justify-content-between align-items-start">
                <div class="sai-action-title">@section.Title</div>
                <span class="sai-badge @(section.Status?.StartsWith("Used") == true ? "sai-badge-positive" : "sai-badge-neutral")">@section.Status</span>
            </div>
            <div class="sai-action-desc mt-1">@section.Text</div>
            @if (section.Regime is { } regime)
            {
                <div class="mt-2"><strong>NIFTY 50: @(regime.Regime ?? "Unavailable")</strong> <span class="text-muted">as of @ProductFormat.DateTimeIst(regime.AsOfDate)</span></div>
                @if (!string.IsNullOrEmpty(regime.Reason))
                {
                    <div class="sai-action-desc">@regime.Reason</div>
                }
            }
            @if (section.MarketStatus is { } ms)
            {
                <div class="sai-action-desc">@ms.Label - @ProductFormat.DateTimeIst(ms.NowIst)</div>
            }
        </div>
    }

    @if (o.Sections.FirstOrDefault(x => x.Key == "legacy") is { } legacy)
    {
        <details class="sai-card" @ontoggle="LoadLegacyAsync">
            <summary>@legacy.Title - @legacy.Status</summary>
            <div class="sai-banner sai-banner-warning mt-2">@legacy.Text</div>
            @if (_legacyLoading)
            {
                <LoadingState Message="Loading legacy analytics..." />
            }
            else if (_legacyError is not null)
            {
                <div class="sai-action-desc">@_legacyError</div>
            }
            else if (_legacy is { } report)
            {
                @if (report.Summary.Total == 0)
                {
                    <div class="sai-action-desc">No legacy records.</div>
                }
                else
                {
                    <div class="sai-action-desc">@report.Summary.Total legacy signals (BUY/SELL/HOLD, mixed definitions of success).</div>
                    @foreach (var sig in report.SignalAnalysis)
                    {
                        <div class="sai-row"><div><SignalBadge Signal="@sig.Signal" /></div><div class="sai-row-value">@sig.Trades signals</div></div>
                    }
                    @foreach (var r in report.RegimeAnalysis)
                    {
                        <div class="sai-row"><div>Regime: @r.Regime</div><div class="sai-row-value">@r.Trades signals</div></div>
                    }
                }
            }
        </details>
    }

    <div class="sai-action-desc">@o.Note</div>
    <Disclaimer Text="@AppConfig.Disclaimer" />
}

@code {
    private IntelligenceOverview? _overview;
    private bool _loading = true;
    private string? _error;
    private ApiErrorKind? _errorKind;
    private IntelligenceReport? _legacy;
    private bool _legacyLoading;
    private bool _legacyRequested;
    private string? _legacyError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            _overview = await ProductApi.GetIntelligenceOverviewAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _errorKind = ex.Kind;
        }
        catch (Exception)
        {
            _error = "The server returned data the app could not read.";
        }
        _loading = false;
    }

    private async Task LoadLegacyAsync()
    {
        if (_legacyRequested) return;
        _legacyRequested = _legacyLoading = true;
        try
        {
            _legacy = await IntelligenceApiClient.GetReportAsync();
        }
        catch (ApiException ex)
        {
            _legacyError = ex.Message;
        }
        catch (Exception)
        {
            _legacyError = "The legacy report could not be read.";
        }
        _legacyLoading = false;
    }
}
