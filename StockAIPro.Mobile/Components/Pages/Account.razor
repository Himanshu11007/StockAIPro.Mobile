@page "/account"
@using StockAIPro.Mobile.Models.Auth
@using StockAIPro.Mobile.Services.Api
@using StockAIPro.Mobile.Services.Authentication
@inject IAuthService AuthService
@inject IPinService PinService
@inject IGoogleSignInService GoogleSignIn
@inject IAppleSignInService AppleSignIn
@inject NavigationManager Navigation
@inject INotificationApiClient NotificationApi
@inject AppConfigService AppConfig
@implements IDisposable

<div class="sai-card">
    <div class="sai-card-title">Account</div>

    @if (_isLoading)
    {
        <LoadingState Message="Checking authentication..." />
    }
    else if (!AuthService.IsAuthenticated || AuthService.CurrentUser is null)
    {
        <p>You're not signed in.</p>
        <p><a href="/login">Login</a> &nbsp;|&nbsp; <a href="/register">Register</a></p>
    }
    else
    {
        var user = AuthService.CurrentUser;

        <div class="sai-metric-grid mb-3">
            <MetricCard Label="Email / Phone" Value="@(user.Email ?? user.Phone ?? "—")" />
            <MetricCard Label="Status" Value="@(user.IsActive ? "Active" : "Inactive")" />
            <MetricCard Label="@(user.Roles.Count == 1 ? "Role" : "Roles")" Value="@string.Join(", ", user.Roles)" />
            <MetricCard Label="Created" Value="@user.CreatedAt.ToLocalTime().ToString("d MMM yyyy")" />
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <p>@_statusMessage</p>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="text-danger" role="alert">@_errorMessage</p>
        }

        <button class="btn btn-secondary w-100 mb-2" @onclick="RefreshProfileAsync" disabled="@_isBusy">
            @(_isBusy ? "Working..." : "Refresh profile")
        </button>

        <button class="btn btn-outline-danger w-100 mb-4" @onclick="LogoutAsync" disabled="@_isBusy">
            Logout
        </button>

        <div class="sai-card-title">Security</div>

        @if (_isPinSet)
        {
            <p>A PIN is set up for this device.</p>
            <button class="btn btn-outline-secondary w-100 mb-2" @onclick="RemovePinAsync" disabled="@_isBusy">
                Remove PIN from this device
            </button>
        }
        else
        {
            <p><a href="/pin/create">Set up a PIN</a> for faster unlock on this device.</p>
        }

        <button class="btn btn-outline-secondary w-100 mb-2" @onclick="SignOutOtherDevicesAsync" disabled="@_isBusy">
            Sign out all other devices
        </button>
        <button class="btn btn-outline-danger w-100 mb-4" @onclick="SignOutAllDevicesAsync" disabled="@_isBusy">
            Sign out all devices
        </button>

        <div class="sai-card-title">Linked sign-in methods</div>
        @if (_identities is { Count: > 0 })
        {
            <ul>
                @foreach (var identity in _identities)
                {
                    <li>@identity.Provider @(identity.Email is null ? "" : $"({identity.Email})")</li>
                }
            </ul>
        }
        else
        {
            <p>No Google or Apple account linked.</p>
        }

        <button class="btn btn-outline-secondary w-100 mb-2" @onclick="LinkGoogleAsync" disabled="@_isBusy">
            Link Google account
        </button>
        <button class="btn btn-outline-secondary w-100 mb-4" @onclick="LinkAppleAsync" disabled="@_isBusy">
            Link Apple account
        </button>

        <div class="sai-card-title">Notifications</div>
        <div class="sai-action-list mb-4">
            <a class="sai-action-item" href="notifications"><div class="sai-action-title">Notification Center</div><span class="sai-action-arrow">›</span></a>
            <a class="sai-action-item" href="settings/notifications"><div class="sai-action-title">Notification settings</div><span class="sai-action-arrow">›</span></a>
        </div>

        <div class="sai-card-title">Active sessions</div>
        @if (_sessions is null)
        {
            <button class="btn btn-outline-secondary w-100 mb-4" @onclick="LoadSessionsAsync" disabled="@_isBusy">Show signed-in devices</button>
        }
        else
        {
            <div class="mb-4">
                @foreach (var sess in _sessions)
                {
                    <div class="sai-row">
                        <div>@(sess.DeviceName ?? "Unknown device")@(sess.DeviceId == _deviceId ? " (this device)" : "")</div>
                        <div class="sai-row-value">signed in @sess.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</div>
                    </div>
                }
                @if (_sessions.Count == 0)
                {
                    <div class="sai-action-desc">No active sessions.</div>
                }
            </div>
        }

        <div class="sai-card-title">Help and privacy</div>
        <div class="sai-action-list mb-3">
            <a class="sai-action-item" href="report"><div><div class="sai-action-title">Report a problem</div><div class="sai-action-desc">Incorrect or stale data, company information, rankings, or an app problem</div></div><span class="sai-action-arrow">›</span></a>
            <a class="sai-action-item" href="privacy"><div class="sai-action-title">Privacy and terms</div><span class="sai-action-arrow">›</span></a>
            <a class="sai-action-item" href="welcome"><div class="sai-action-title">How it works (introduction)</div><span class="sai-action-arrow">›</span></a>
        </div>

        <div class="sai-card-title">Delete account</div>
        @if (!_confirmDelete)
        {
            <button class="btn btn-outline-danger w-100 mb-3" @onclick="() => _confirmDelete = true" disabled="@_isBusy">Request account deletion</button>
        }
        else
        {
            <div class="sai-banner sai-banner-warning">
                Your request is recorded and processed by an administrator. Your account stays active until then.
                <textarea class="form-control mt-2" rows="2" placeholder="Reason (optional)" @bind="_deleteReason"></textarea>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-danger flex-fill" @onclick="RequestDeletionAsync" disabled="@_isBusy">Send request</button>
                    <button class="btn btn-secondary flex-fill" @onclick="() => _confirmDelete = false">Cancel</button>
                </div>
            </div>
        }

        <div class="sai-action-desc text-muted mt-3">App version @AppInfo.Current.VersionString (build @AppInfo.Current.BuildString)</div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isPinSet;
    private string? _statusMessage;
    private string? _errorMessage;
    private List<LinkedIdentityResponse> _identities = [];
    private List<SessionResponse>? _sessions;
    private string? _deviceId;
    private bool _confirmDelete;
    private string? _deleteReason;

    private async Task LoadSessionsAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            _deviceId = await AuthService.GetDeviceIdAsync();
            _sessions = await AuthService.GetSessionsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RequestDeletionAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var receipt = await NotificationApi.RequestAccountDeletionAsync(string.IsNullOrWhiteSpace(_deleteReason) ? null : _deleteReason);
            _statusMessage = receipt.Message;
            _confirmDelete = false;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;

        if (!AuthService.IsAuthenticated)
        {
            // Handles both "never logged in this session" and "app just
            // started" - TryRestoreSessionAsync is safe to call even if a
            // session is already established (it's a no-op cost either way
            // here since we only reach this branch when not authenticated).
            await AuthService.TryRestoreSessionAsync();
        }

        _isPinSet = await PinService.IsPinSetAsync();

        if (AuthService.IsAuthenticated)
        {
            try
            {
                _identities = await AuthService.GetLinkedIdentitiesAsync();
            }
            catch (ApiException)
            {
                // Non-critical for this page - leave the list empty rather
                // than blocking the rest of the account page on it.
            }
        }

        _isLoading = false;
    }

    private async Task RefreshProfileAsync()
    {
        _statusMessage = null;
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await AuthService.RefreshCurrentUserAsync();
            _statusMessage = "Profile refreshed from the backend.";
        }
        catch (ApiException ex) when (ex.Kind == ApiErrorKind.NetworkUnavailable)
        {
            _errorMessage = "Could not reach the StockAI Pro server. Check your connection and try again.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        _isBusy = true;
        try
        {
            await AuthService.LogoutAsync();
        }
        finally
        {
            _isBusy = false;
        }
        Navigation.NavigateTo("/login");
    }

    private async Task RemovePinAsync()
    {
        _isBusy = true;
        try
        {
            await PinService.ClearPinAsync();
            _isPinSet = false;
            try
            {
                await AuthService.SetPinEnabledAsync(false);
            }
            catch (ApiException)
            {
                // Best-effort - the PIN is already gone locally either way.
            }
            _statusMessage = "PIN removed from this device.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SignOutOtherDevicesAsync()
    {
        _statusMessage = null;
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var count = await AuthService.SignOutAllDevicesAsync(exceptCurrent: true);
            _statusMessage = $"Signed out {count} other device(s). This device stays signed in.";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SignOutAllDevicesAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            // AuthService clears local credentials itself once the server
            // confirms the revocation (exceptCurrent: false includes this
            // device) - only navigate away once that has actually happened,
            // so a failed/offline attempt doesn't strand the UI on /login
            // while this device's own session is still technically valid.
            await AuthService.SignOutAllDevicesAsync(exceptCurrent: false);
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LinkGoogleAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var idToken = await GoogleSignIn.SignInAsync();
            if (idToken is not null)
            {
                await AuthService.LinkGoogleAsync(idToken);
                _identities = await AuthService.GetLinkedIdentitiesAsync();
                _statusMessage = "Google account linked.";
            }
        }
        catch (GoogleSignInNotConfiguredException)
        {
            _errorMessage = "Google sign-in is not configured on this device.";
        }
        catch (GoogleSignInFailedException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LinkAppleAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var identityToken = await AppleSignIn.SignInAsync();
            if (identityToken is not null)
            {
                await AuthService.LinkAppleAsync(identityToken);
                _identities = await AuthService.GetLinkedIdentitiesAsync();
                _statusMessage = "Apple account linked.";
            }
        }
        catch (AppleSignInNotConfiguredException)
        {
            _errorMessage = "Apple sign-in is currently unavailable.";
        }
        catch (AppleSignInFailedException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthService.AuthStateChanged -= OnAuthStateChanged;
}
