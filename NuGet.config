<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins package restore to the public nuget.org feed for this repository.

  Without this file, restore falls back to whatever NuGet feeds happen to
  be registered machine-wide (via `dotnet nuget list source`) - on at least
  one development machine that includes a private organizational Azure
  DevOps feed unrelated to this project, which requires authentication this
  repo's contributors/CI don't have and makes restore fail with a 401 the
  moment any package isn't already cached locally. Scoping this repo to
  nuget.org only makes restore reproducible regardless of what other feeds
  a given machine has configured.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
